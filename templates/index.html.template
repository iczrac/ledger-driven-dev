    '<button class="ctx-clear" type="button" data-jump="design">设计理念</button>'+
    '<button class="ctx-clear" type="button" data-action="expand">展开全部</button>'+
    '<button class="ctx-clear" type="button" data-action="collapse">收起全部</button></span>';
  const q=document.getElementById('q'); if(q && meta.ph) q.placeholder=meta.ph;
  const clear=document.getElementById('qclear'); if(clear) clear.hidden=!query;
