  const decs=(di.decisions||[]).map(d=>{const e=VIEW_DATA.entries.find(x=>x.id===d.id);return '<span class="chip" title="'+esc(e?e.decision||e.title:d.title)+'">'+esc(d.id)+' '+esc(d.status||'')+'</span>';}).join('');
  if(decs)s+='<div class="idxgrp"><span class="k">关联决策</span><span>'+decs+'</span></div>';
  const cc=di.control_center||{};
  if(cc.page||(cc.sections||[]).length)s+='<div class="idxgrp"><span class="k">控制入口</span><span>'+(cc.page?'<a class="doclink" href="'+ROOT+VIEW_DATA.module_map.pages_path+esc(cc.page)+'.html">🖥 '+esc(cc.page)+' 页面</a>':'')+(cc.sections||[]).map(x=>'<span class="chip s">'+esc(x)+'</span>').join('')+'</span></div>';
  return s+'</div>';
}

