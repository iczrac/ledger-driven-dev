  else{
    const all=[].concat.apply([],codes.map(c=>(maturity[c]||{}).series||[]));
    const seqs=all.map(p=>p.seq||0), min=Math.min.apply(null,seqs), max=Math.max.apply(null,seqs);
    const W=920,H=320,L=44,T=18,B=42;
