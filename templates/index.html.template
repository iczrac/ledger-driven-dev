  design:{name:'设计理念',hint:'七条原则解释界面为什么这样组织；每条都对应一个可见落点',ph:'搜索原则 / 界面落点 / 反例…'},
  diagram:{name:'架构图',hint:'账本 → 生成器 → 投影 → 视图的分层结构；节点可点击下钻',ph:'搜索架构节点 / 投影 / 视图（命中节点将高亮）…'},
  flow:{name:'数据流',hint:'账本驱动的实时计数：每条边标注当前数据规模，数字来自账本',ph:'搜索数据流节点 / 计数 / 来源（命中节点将高亮）…'}
};
let view='workbench', query='';
// 数据来源徽标：内嵌快照先渲染，同目录 JSON 成功后再标注为实时；失败如实降级。
let DATA_SOURCE='内嵌快照';
// 规模契约：所有项目共用同一模板与同一分批上限；禁止在项目里改 CSS / DOM / 此常量。
// scale_budget.py 会解析 PAGE_SIZE，保证预算口径与实际渲染一致。
const PAGE_SIZE=200;
let pageLimit=PAGE_SIZE;
function moreHtml(total,shown,label){
  if(total<=shown) return '';
  return '<div class="empty"><button class="tab" id="btn-more" type="button">显示更多'+esc(label||'')+
    '（已 '+shown+' / 共 '+total+' · 每批 '+PAGE_SIZE+'）</button></div>';
}
function bindMore(box){
  const b=box.querySelector('#btn-more');
  if(b) b.onclick=()=>{pageLimit+=PAGE_SIZE;render();};
}
let workScope='';
const W_KIND={todo:'待办',issue:'缺陷'};
const W_STATUS={open:'待处理',doing:'进行中',done:'已完成',blocked:'阻塞'};

function allCaps(){
  const out=[];
  ((VIEW_DATA.capability_model||{}).projects||[]).forEach(p=>(p.modules||[]).forEach(m=>(m.caps||[]).forEach(c=>out.push(c))));
  return out;
}
/* ---- v2.11.0 分析层：所有数字都从 VIEW_DATA 派生，不写回账本 ---- */
const ANALYTICS_SCHEMA='maturity-analytics/1';
const HEALTH_WEIGHTS={evidence_freshness:.20,test_pass_rate:.25,decision_backlog:.15,
  verified_coverage:.20,work_health:.20};
let selectedCap='', tierFilter='all';
let whatIf={active:false,overrides:{}};
function cloneData(d){return JSON.parse(JSON.stringify(d));}
function capByCode(code){return allCaps().find(c=>c.code===code)||null;}
function round1(n){return Math.round(n*10)/10;}
/* ---- v2.12.0 本地 D3：只增强渲染；hasD3() 为 false 时全部走原生降级 ---- */
const LINEAGE_SCHEMA='trace-lineage/1';
const LEVEL_COLORS=['#F1EFE8','#E6F1FB','#EEEDFE','#FAEEDA','#E1F5EE','#0F6E56'];
const D3_KIND_COLORS={capability:'#534AB7',decision:'#185FA5',evidence:'#5F5E5A',state:'#0F6E56'};
const TREND_COLORS=['#534AB7','#185FA5','#0F6E56','#854F0B','#A32D2D','#5F5E5A','#6f42c1','#0b7285'];
function hasD3(){return typeof d3!=='undefined'&&!!d3.select&&!!d3.scaleLinear&&!!d3.hierarchy;}
function d3Color(level){return LEVEL_COLORS[Math.max(0,Math.min(5,Number(level)||0))];}
function shortLabel(s,n){s=String(s||'');return s.length>n?s.slice(0,n-1)+'…':s;}
// 旧账本没有 lineage 字段时，按同一路径规则在内存派生，仍不写回文件。
function deriveLineage(d,caps){
  const entries={};((d.entries||[]).forEach(e=>{if(e.id)entries[e.id]=e;}));
  const trees={};
  caps.forEach(c=>{
    const code=c.code,rootId='cap:'+code,di=c.doc_index||{},children=[];
    (di.decisions||[]).forEach(ref=>{
      const did=ref.id;if(!did)return;
      const e=entries[did]||{},decId=rootId+'/dec:'+did;
      children.push({id:decId,kind:'decision',label:ref.title||did,decision_id:did,
        status:ref.status||e.status||'',children:(e.evidence||[]).slice(0,6).map(p=>({
          id:decId+'/ev:decision:'+p,kind:'evidence',label:p.split('/').pop()||p,
          category:'decision',path:p,children:[]}))});
    });
    ['plans','contracts','impl','unit_tests','test_records'].forEach(key=>{
      (di[key]||[]).slice(0,6).forEach(x=>{
        const p=typeof x==='string'?x:(x.path||'');if(!p)return;
        children.push({id:rootId+'/ev:'+key+':'+p,kind:'evidence',
          label:p.split('/').pop()||p,category:key,path:p,children:[]});
      });
    });
    children.push({id:rootId+'/state',kind:'state',
      label:'L'+c.level+' · '+(c.evidence_tier||'declared')+' · '+(c.completion||0),
      level:c.level,tier:c.evidence_tier||'declared',completion:c.completion||0,children:[]});
    trees[code]={id:rootId,kind:'capability',code:code,label:c.name||code,
      status:{level:c.level,tier:c.evidence_tier||'declared',completion:c.completion||0},children:children};
  });
  return {schema:LINEAGE_SCHEMA,purpose:'前端降级投影：旧账本也能钻取证据，不写回文件',
    node_kinds:['capability','decision','evidence','state'],group_limit:6,trees:trees};
}
function deriveTimeline(events){
  return (events||[]).map(ev=>{
    const ch=ev.changes||{},codes={},keys=['level_transitions','added','removed','completion_delta','evidence_changes'];
    keys.forEach(k=>(ch[k]||[]).forEach(x=>{const code=typeof x==='string'?x:x.code;if(code)codes[code]=1;}));
    return {seq:ev.seq,ts:ev.ts||'',type:ev.type||'',note:ev.note||'',
      fingerprint:ev.fingerprint_after||null,
      change_count:keys.reduce((n,k)=>n+(ch[k]||[]).length,0),codes:Object.keys(codes).slice(0,6)};
  });
}
function recomputeHealth(cm,d,overrides){
  const caps=[];
  ((cm||{}).projects||[]).forEach(p=>(p.modules||[]).forEach(m=>(m.caps||[]).forEach(c=>{
    const ov=(overrides||{})[c.code]||{};
    const level=ov.level===undefined?c.level:ov.level;
    const tier=ov.tier||c.evidence_tier||'declared';
    caps.push({code:c.code,level:level,tier:tier,completion:round1(level/5)});
  })));
  const sm=(cm||{}).summary||{};
  const freshScores={fresh:100,stale:50,unbound:20};
  const fresh=freshScores[sm.evidence_freshness||'unbound']===undefined
    ?20:freshScores[sm.evidence_freshness];
  const cases=((d||{}).test_results||{}).cases||[];
  const passed=cases.filter(c=>c.status==='pass').length;
  const failed=cases.filter(c=>c.status==='fail'||c.status==='error').length;
  const open=(d.entries||[]).filter(e=>e.status==='proposed'||e.status==='deferred').length;
  const verified=caps.filter(c=>c.tier==='verified').length;
  const issues=(d.work_items||[]).filter(x=>x.kind==='issue'&&x.status!=='done');
  const blocked=issues.filter(x=>x.status==='blocked').length;
  const dims={
    evidence_freshness:{score:fresh,weight:HEALTH_WEIGHTS.evidence_freshness,detail:sm.evidence_freshness||'unbound'},
    test_pass_rate:{score:cases.length?round1(100*passed/cases.length):0,weight:HEALTH_WEIGHTS.test_pass_rate,detail:passed+'/'+cases.length},
    decision_backlog:{score:Math.max(0,100-Math.min(100,open*10)),weight:HEALTH_WEIGHTS.decision_backlog,detail:'open='+open},
    verified_coverage:{score:caps.length?round1(100*verified/caps.length):0,weight:HEALTH_WEIGHTS.verified_coverage,detail:verified+'/'+caps.length},
    work_health:{score:Math.max(0,100-Math.min(100,blocked*20+(issues.length-blocked)*8+failed*15)),weight:HEALTH_WEIGHTS.work_health,detail:'blocked='+blocked+' failed='+failed}
  };
  let overall=0;Object.keys(dims).forEach(k=>{overall+=dims[k].score*dims[k].weight;});
  return {dimensions:dims,overall:round1(overall)};
}
function deriveAnalytics(d){
  const cm=d.capability_model||{}, caps=[];
  ((cm.projects||[]).forEach(p=>(p.modules||[]).forEach(m=>(m.caps||[]).forEach(c=>caps.push(c)))));
  const events=(d.history||{}).events||[];
  const maturity={};
  caps.forEach(c=>{maturity[c.code]={series:[],current_level:c.level,current_tier:c.evidence_tier||'declared'};});
  events.forEach(ev=>{
    const sd=ev.state_digest||{};
    Object.keys(sd).forEach(code=>{
      if(!maturity[code])return;
      const st=sd[code]||{}, lv=st.l||0;
      const pt={seq:ev.seq,ts:ev.ts||'',level:lv,level_code:'L'+lv,completion:st.c||0,tier:st.t||'declared'};
      const s=maturity[code].series, last=s[s.length-1];
      if(!last||last.level!==lv||last.tier!==pt.tier||last.completion!==pt.completion)s.push(pt);
    });
  });
  caps.forEach(c=>{
    const s=maturity[c.code].series, pt={seq:events.length,ts:events.length?events[events.length-1].ts||'':'',
      level:c.level,level_code:c.level_code||('L'+c.level),completion:c.completion||0,
      tier:c.evidence_tier||'declared'}, last=s[s.length-1];
    if(!last||last.level!==pt.level||last.tier!==pt.tier||last.completion!==pt.completion)s.push(pt);
  });
  const prev=events.length>1?(events[events.length-2].state_digest||{}):{};
  const lastEv=events[events.length-1]||{}, lastSd=lastEv.state_digest||{};
  const transitions=[];
  Object.keys(lastSd).forEach(code=>{
    if(prev[code]&&prev[code].l!==lastSd[code].l)
      transitions.push({code:code,from:'L'+prev[code].l,to:'L'+lastSd[code].l});
  });
  return {schema:ANALYTICS_SCHEMA,purpose:'前端降级投影：旧账本也能画热力图与趋势，不写回文件',
    levels:['L0','L1','L2','L3','L4','L5'],maturity:maturity,
    change_summary:{event_seq:lastEv.seq||0,ts:lastEv.ts||'',from_fingerprint:lastEv.fingerprint_before||null,
      to_fingerprint:lastEv.fingerprint_after||null,level_transitions:transitions,
      added:[],removed:[],completion_delta:[],evidence_changes:[]},
    health:recomputeHealth(cm,d),recommended_actions:[],
    timeline:deriveTimeline(events),lineage:deriveLineage(d,caps)};
}
function ensureAnalytics(){
  const cm=VIEW_DATA.capability_model;
  if(!cm)return null;
  if(!cm.analytics||cm.analytics.schema!==ANALYTICS_SCHEMA)cm.analytics=deriveAnalytics(VIEW_DATA);
  return cm.analytics;
}
function applyWhatIf(){
  if(!whatIf.active){VIEW_DATA=DATA;return VIEW_DATA;}
  VIEW_DATA=cloneData(DATA);
  const cm=VIEW_DATA.capability_model||{};
  const overrides=whatIf.overrides||{};
  ((cm.projects||[]).forEach(p=>(p.modules||[]).forEach(m=>(m.caps||[]).forEach(c=>{
    const ov=overrides[c.code];if(!ov)return;
    if(ov.level!==undefined){c.level=Math.max(0,Math.min(5,ov.level));c.completion=round1(c.level/5);
      c.level_code='L'+c.level;c.next_level=Math.min(5,c.level+1);}
    if(ov.tier){c.evidence_tier=ov.tier;}
  }))));
  ensureAnalytics();
  // 假设只改内存副本：同步时间序列末点、追溯树状态节点与变更高亮信号。
  // 这样趋势图/热力图/追溯链一起变化，但 DATA（账本）永远不动。
  const a=cm.analytics||{}, activeCodes=Object.keys(overrides).filter(k=>overrides[k]&&Object.keys(overrides[k]).length);
  activeCodes.forEach(code=>{
    const c=allCaps().find(x=>x.code===code);if(!c)return;
    const row=(a.maturity||{})[code];
    if(row){
      row.current_level=c.level;row.current_tier=c.evidence_tier||'declared';
      const series=row.series||[], events=(VIEW_DATA.history||{}).events||[];
      const pt={seq:events.length,ts:events.length?events[events.length-1].ts||'':'',
        level:c.level,level_code:'L'+c.level,completion:c.completion||0,
        tier:c.evidence_tier||'declared'};
      const last=series[series.length-1];
      if(last&&last.seq===pt.seq&&last.level===pt.level&&last.tier===pt.tier)series[series.length-1]=pt;
      else series.push(pt);
      row.series=series;
    }
    const tree=((a.lineage||{}).trees||{})[code];
    if(tree){
      tree.status={level:c.level,tier:c.evidence_tier||'declared',completion:c.completion||0};
      (tree.children||[]).forEach(n=>{
        if(n.kind==='state'){n.level=c.level;n.tier=c.evidence_tier||'declared';
          n.completion=c.completion||0;n.label='L'+c.level+' · '+n.tier+' · '+n.completion;}
      });
    }
  });
  if(activeCodes.length){
    const ch=a.change_summary||(a.change_summary={});
    ch.added=Array.from(new Set((ch.added||[]).concat(activeCodes)));
    ch.to_fingerprint=String(ch.to_fingerprint||'base').replace(/:whatif$/,'')+':whatif';
  }
  const health=recomputeHealth(cm,VIEW_DATA);
  cm.summary=cm.summary||{};cm.summary.health_dimensions={};
  Object.keys(health.dimensions).forEach(k=>{cm.summary.health_dimensions[k]=health.dimensions[k].score;});
  cm.summary.health_overall=health.overall;
  cm.analytics.health=health;
  const gain={};(cm.analytics.recommended_actions||[]).forEach(a=>{gain[a.code]=a.health_gain;});
  cm.next_queue=(cm.next_queue||[]).map(t=>Object.assign({},t,{health_impact:gain[t.code]||0}));
  return VIEW_DATA;
}
