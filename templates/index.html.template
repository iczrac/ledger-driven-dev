function bindContext(box){
  box.onclick=ev=>{
    const b=ev.target&&ev.target.closest?ev.target.closest('[data-clear],[data-action],[data-jump]'):null;
    if(!b||!b.dataset) return;
    if(b.dataset.clear==='query') clearQuery();
    else if(b.dataset.clear==='scope') clearScope();
    else if(b.dataset.action==='whatif'){toggleWhatIf();return;}
    else if(b.dataset.jump) setView(b.dataset.jump);
    else if(b.dataset.action==='expand'||b.dataset.action==='collapse'){
      const open=b.dataset.action==='expand';
      box.querySelectorAll('.card,.witem,.lesson').forEach(c=>{
        if(c.classList) c.classList[open?'add':'remove']('open');
        const t=c.querySelector?c.querySelector('.toggle'):null;
        if(t) t.textContent=open?'收起 ▴':'展开 ▾';
      });
      box.querySelectorAll('details').forEach(d=>{if('open' in d) d.open=open;});
    }
  };
}
function toggleNav(force){
  const bar=document.getElementById('nav'), btn=document.getElementById('navtoggle');
  if(!bar||!btn) return;
  const cur=bar.classList&&bar.classList.contains?bar.classList.contains('expanded'):false;
  const open=force===undefined?!cur:force;
  if(bar.classList){ if(open)bar.classList.add('expanded');else bar.classList.remove('expanded'); }
  if(btn.setAttribute) btn.setAttribute('aria-expanded',open?'true':'false');
  btn.textContent=open?'收起视图 ▴':'更多视图 ▾';
}
function bindNavToggle(){const b=document.getElementById('navtoggle');if(b)b.onclick=()=>toggleNav();}
function bindJumps(box){
  if(!box) return;
  const go=el=>{const v=el&&el.dataset?el.dataset.jump:null;if(v)setView(v);};
  box.onclick=ev=>{const t=ev.target&&ev.target.closest?ev.target.closest('[data-jump]'):null;if(t)go(t);};
  box.onkeydown=ev=>{
    if(ev.key!=='Enter'&&ev.key!==' ')return;
    const t=ev.target&&ev.target.closest?ev.target.closest('[data-jump]'):null;
    if(t){if(ev.preventDefault)ev.preventDefault();go(t);}
  };
}
function bindStats(box){bindJumps(box);}
