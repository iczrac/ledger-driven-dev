function scopeApplies(scope,code){
  return scope==='PROJECT'||scope===code||code.indexOf(scope+'.')===0;
}
function workScopeCodes(scope){
  return allCaps().map(c=>c.code).filter(c=>scope==='PROJECT'||c===scope||c.indexOf(scope+'.')===0);
}
function unitTestPaths(codes){
  const want={};codes.forEach(c=>want[c]=1);const out=[];
  allCaps().forEach(c=>{if(!want[c.code])return;((c.doc_index||{}).unit_tests||[]).forEach(x=>out.push(typeof x==='string'?x:(x.path||'')));});
  return out.filter(Boolean);
}
function nodeItems(scope){
  const codes=workScopeCodes(scope);
  return (VIEW_DATA.work_items||[]).filter(x=>x.scope===scope||codes.some(c=>scopeApplies(x.scope||'',c)));
}
function nodeTests(scope){
  const norm=s=>String(s||'').replace(/\\/g,'/').replace(/^\.\//,'');
  const ps=unitTestPaths(workScopeCodes(scope)).map(norm);
  return ((VIEW_DATA.test_results||{}).cases||[]).filter(c=>{
    const f=norm(c.file);
    return ps.some(p=>f===p||f.slice(-p.length-1)==='/'+p||p.slice(-f.length-1)==='/'+f);
  });
}
function nodeWork(scope){
  const codes=workScopeCodes(scope), items=nodeItems(scope), tc=nodeTests(scope);
  const todo=items.filter(x=>x.kind==='todo'&&x.status!=='done');
  const issues=items.filter(x=>x.kind==='issue'&&x.status!=='done');
  const blocked=issues.filter(x=>x.status==='blocked');
  const failed=tc.filter(c=>c.status==='fail'||c.status==='error');
  const fresh=((VIEW_DATA.capability_model||{}).summary||{}).evidence_freshness;
  const declared=codes.some(c=>{const cap=allCaps().find(x=>x.code===c);return cap&&cap.evidence_tier!=='verified';});
  const penalty=20*blocked.length+8*(issues.length-blocked.length)+15*failed.length+(fresh!=='fresh'?15:0)+(declared?10:0);
  return {scope:scope,items:items,todo:todo,issues:issues,blocked:blocked,tests:tc,
          failed:failed,declared:declared,fresh:fresh||'unbound',health:Math.max(0,100-penalty)};
}
function healthChip(h){
  const cls=h>=80?'':h>=50?'mid':'bad';
  return '<span class="wchip w-health '+cls+'" title="按阻塞缺陷 / 失败测试 / 证据新鲜度 / declared 能力复算">健康度 '+h+'</span>';
}
function workStripHtml(scope){
  const w=nodeWork(scope);
