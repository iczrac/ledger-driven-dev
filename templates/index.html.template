function renderLineageD3(box,tree,code){
  const host=box.querySelector('#d3-lineage-root');if(!host)return;
  const detail=box.querySelector('#lineage-detail');
  const root=d3.hierarchy(tree);
  root.descendants().forEach(d=>{d._children=d.children;if(d.depth>=1)d.children=null;});
  const rowH=30,height=Math.max(280,root.descendants().length*rowH+60);
  d3.tree().nodeSize([rowH,190])(root);
  const svg=d3.select(host).append('svg').attr('viewBox','0 0 1000 '+height)
    .attr('role','img').attr('aria-label','追溯链（D3）');
  const g=svg.append('g').attr('transform','translate(60,30)');
  const linkG=g.append('g').attr('class','lineage-links');
  const nodeG=g.append('g').attr('class','lineage-nodes');
  const link=d3.linkHorizontal().x(d=>d.y).y(d=>d.x);
  function update(){
    const nodes=root.descendants(),links=root.links();
    linkG.selectAll('path').data(links,d=>d.target.data.id).join('path')
      .attr('class','lineage-link').attr('d',link);
    const sel=nodeG.selectAll('g.lineage-node').data(nodes,d=>d.data.id);
    const enter=sel.enter().append('g').attr('class','lineage-node')
      .attr('tabindex',0).attr('role','button');
    enter.append('circle').attr('r',8);
    enter.append('text').attr('x',14).attr('dy',4);
    enter.append('title');
    const merged=enter.merge(sel)
      .attr('transform',d=>'translate('+d.x+','+d.y+')')
      .attr('data-kind',d=>d.data.kind);
    merged.select('circle').attr('fill',d=>D3_KIND_COLORS[d.data.kind]||'#5F5E5A');
    merged.select('text').text(d=>shortLabel(d.data.label||d.data.id,28));
    merged.select('title').text(d=>(d.data.path||d.data.label||d.data.id||''));
    merged.on('click',(ev,d)=>{
      if(detail)detail.innerHTML=lineageDetailHtml(d.data);
      if(d.children||d._children){d.children=d.children?null:d._children;update();}
    }).on('keydown',(ev,d)=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();
      if(detail)detail.innerHTML=lineageDetailHtml(d.data);
      if(d.children||d._children){d.children=d.children?null:d._children;update();}}});
    sel.exit().remove();
  }
  update();
}
