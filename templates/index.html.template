  const w=nodeWork(workScope||'PROJECT');
  let html='<div class="specbox"><b>作用域</b> '+esc(workScope||'PROJECT（全部）')+' · <b>工作项</b> '+list.length+
    ' · <b>TODO</b> '+w.todo.length+' · <b>Issue</b> '+w.issues.length+'（阻塞 '+w.blocked.length+'） · '+
    '<b>测试</b> '+w.tests.length+' 条（失败 '+w.failed.length+'） · '+healthChip(w.health)+'</div>';
  html+=workStripHtml(workScope||'PROJECT');
