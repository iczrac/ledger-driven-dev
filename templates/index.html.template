function init(){
  // 先用内嵌账本立刻渲染，再尝试同目录 JSON 刷新；离线也能看到内容。
  render();
  fetch('DECISION_LEDGER.json').then(r=>r.ok?r.json():Promise.reject())
    .then(d=>{DATA=d;VIEW_DATA=d;DATA_SOURCE='实时 JSON';render();})
    .catch(()=>{DATA_SOURCE='离线快照';render();});
  document.querySelectorAll('.bar .tab').forEach(t=>t.onclick=()=>setView(t.dataset.v));
  const q=document.getElementById('q');
  if(q) q.oninput=e=>{query=e.target.value.toLowerCase();pageLimit=PAGE_SIZE;render();};
  const qc=document.getElementById('qclear'); if(qc) qc.onclick=clearQuery;
  bindNavToggle();
  bindStats(document.getElementById('stats'));
  bindContext(document.getElementById('context'));
  const back=document.getElementById('backtop');
  if(back) back.onclick=()=>{if(typeof window!=='undefined'&&window.scrollTo)window.scrollTo({top:0,behavior:'smooth'});};
  if(typeof window!=='undefined' && window.addEventListener){
    window.addEventListener('keydown',e=>{
      const tag=(e.target&&e.target.tagName||'').toLowerCase();
      if(e.key==='/'&&tag!=='input'&&tag!=='textarea'){
        e.preventDefault(); const box=document.getElementById('q'); if(box) box.focus(); return;
      }
      if(e.key==='Escape'){ if(query) clearQuery(); else if(workScope) clearScope(); }
    });
    window.addEventListener('scroll',()=>{
      if(!back) return;
      const y=window.scrollY||0; back.hidden=y<240;
    },{passive:true});
  }
}

function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
const ROOT='../../';
function docLink(x,kind){
  if(!x||!x.path) return '';
  const href=ROOT+x.path.replace(/#.*$/,'');
  const label=x.title||x.path.split('/').pop();
  return '<a class="doclink" href="'+href+'" title="'+esc(kind||x.kind||'文档')+' · '+esc(x.path)+'">📄 '+esc(label)+'</a>';
}
function docLinks(arr,kind,limit){return (arr||[]).slice(0,limit||8).map(x=>docLink(x,kind)).join('');}
function treeHtml(nodes,depth){
  if(!nodes||!nodes.length) return '<span style="color:var(--mut);font-size:11px">（无组件）</span>';
  return nodes.map(n=>{
    if(n.type==='dir'){
      return '<details class="tnode"'+(depth===0?' open':'')+'><summary>📁 '+esc(n.name)+' <span class="cid">'+(n.count||'')+'</span></summary>'+
        '<div class="tkids">'+treeHtml(n.children||[],depth+1)+'</div></details>';
    }
    if(n.type==='file') return '<div class="tfile"><a href="'+ROOT+esc(n.path)+'" title="'+esc(n.path)+'">'+esc(n.name)+'</a></div>';
    return '<div class="tfile">'+esc(n.name)+'</div>';
  }).join('');
}
function docIndexHtml(di){
  if(!di) return '';
