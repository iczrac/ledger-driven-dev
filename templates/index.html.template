    return '<div class="wstrip empty-w"><span class="wl">节点工作态</span><span class="wchip">暂无 TODO / issue / 绑定测试</span>'+healthChip(w.health)+'</div>';
  const chips='<span class="wchip w-todo">TODO '+w.todo.length+'</span>'+
    '<span class="wchip w-issue">Issue '+w.issues.length+(w.blocked.length?'（阻塞 '+w.blocked.length+'）':'')+'</span>'+
    '<span class="wchip '+(w.failed.length?'w-fail':'w-test')+'">测试 '+(w.tests.length-w.failed.length)+'/'+w.tests.length+(w.failed.length?' · 失败 '+w.failed.length:'')+'</span>'+
    healthChip(w.health);
  const rows=w.items.map(x=>'<div class="tcase '+(x.status==='blocked'?'fail':'')+'">'+esc(x.id)+' · '+
    esc(W_KIND[x.kind]||x.kind)+' / '+esc(W_STATUS[x.status]||x.status)+' · '+esc(x.title)+'</div>').join('');
  const cases=w.tests.map(c=>'<div class="tcase '+(c.status==='fail'||c.status==='error'?'fail':'pass')+'">'+
    esc(c.status)+' · '+esc(c.id)+' · '+esc(c.file)+'</div>').join('');
  return '<div class="wstrip"><span class="wl">节点工作态</span>'+chips+
    '<button class="wlink" type="button" data-work="'+esc(scope)+'">查看该节点工作项 →</button></div>'+
    ((rows||cases)?'<details class="tnode"><summary>展开本节点 TODO / issue / 测试结果</summary>'+
