function markChanges(box){
  if(!box||!box.querySelectorAll)return;
  let prev={};try{prev=JSON.parse(localStorage.getItem('ledger-driven-dev:view-state')||'{}');}catch(e){}
  const a=(VIEW_DATA.capability_model||{}).analytics||{};
  const fp=((a.change_summary||{}).to_fingerprint)||'';
  const codes={};
  (((a.change_summary||{}).level_transitions)||[]).forEach(t=>{codes[t.code]=1;});
  (((a.change_summary||{}).added)||[]).forEach(c=>{codes[c]=1;});
  if(prev.fingerprint&&fp&&prev.fingerprint!==fp){
    box.querySelectorAll('[data-capcode]').forEach(el=>{if(codes[el.dataset.capcode]&&el.classList)el.classList.add('changed');});
  }
  const workMap={};(VIEW_DATA.work_items||[]).forEach(x=>{workMap[x.id]=workSig(x);});
  const workFp=JSON.stringify(workMap);
  if(prev.work&&prev.work!==workFp){
    const old=prev.work_map||{};
    box.querySelectorAll('[data-wid]').forEach(el=>{
      const id=el.dataset.wid;if(old[id]&&old[id]!==workMap[id]&&el.classList)el.classList.add('changed');
    });
  }
  try{localStorage.setItem('ledger-driven-dev:view-state',JSON.stringify({fingerprint:fp,work:workFp,work_map:workMap}));}catch(e){}
}
