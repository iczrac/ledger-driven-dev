    for(let lv=0;lv<=5;lv++)svg+='<line class="trend-axis" x1="'+L+'" y1="'+y(lv)+'" x2="'+(W-18)+'" y2="'+y(lv)+'"/>'+
      '<text class="trend-label" x="'+(L-26)+'" y="'+(y(lv)+3)+'">L'+lv+'</text>';
    codes.forEach((code,i)=>{
      const pts=(maturity[code]||{}).series||[];
      const d=pts.map((p,j)=>(j?'L':'M')+x(p.seq||0)+' '+y(p.level||0)).join(' ');
      svg+='<path class="trend-line" stroke="'+palette[i%palette.length]+'" d="'+d+'"/>';
      pts.forEach(p=>{svg+='<circle class="trend-dot" cx="'+x(p.seq||0)+'" cy="'+y(p.level||0)+'" r="3.5" fill="'+palette[i%palette.length]+'"><title>'+esc(code)+' #'+esc(p.seq)+' '+esc(p.level_code)+'</title></circle>';});
    });
    [min,max].forEach(s=>{svg+='<text class="trend-label" x="'+x(s)+'" y="'+(H-16)+'" text-anchor="middle">事件 #'+esc(s)+'</text>';});
    svg+='</svg>';
    html+='<div class="trend-wrap"'+(hasD3()?' id="d3-trend-root"':'')+'>'+(hasD3()?'':svg)+'</div>'+
      '<div class="day">序列图例（点击查看证据链）</div><div class="launchpad">'+
      codes.map((code,i)=>'<button class="launch" type="button" data-capcode="'+esc(code)+'" data-cap-select="'+esc(code)+'">'+
        '<div class="lt" style="color:'+palette[i%palette.length]+'">'+esc(code.split('.').slice(-2).join('.'))+'</div>'+
        '<div class="ld">'+esc((capByCode(code)||{}).name||'')+'</div><div class="ln">'+esc(((maturity[code]||{}).series||[]).length)+' 点</div></button>').join('')+'</div>';
  }
  html+=renderEvidenceChain(selectedCap);
  document.getElementById('legend').innerHTML='<span>纵轴为 L0–L5，横轴为事件序号；曲线来自 history.state_digest，非人工填报。</span>';
  box.innerHTML=html;
