<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>决策与能力账本 · 单一事实源</title>
<style>
:root{--ink:#1a1a1a;--mut:#666;--line:#e3e3e3;--bg:#fff;--soft:#f7f7f5;--purple:#534AB7;--pp:#EEEDFE;--green:#0F6E56;--gp:#E1F5EE;--amber:#854F0B;--ap:#FAEEDA;--red:#A32D2D;--rp:#FCEBEB;--blue:#185FA5;--bp:#E6F1FB;--gray:#5F5E5A;--gp2:#F1EFE8;--shadow:0 8px 24px rgba(20,20,30,.06)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--ink);line-height:1.6;max-width:1180px;margin:0 auto;padding:32px 26px 72px;background:var(--bg)}
[hidden]{display:none!important}
.skip-link{position:absolute;left:-9999px;top:8px;z-index:100;background:var(--ink);color:#fff;padding:8px 14px;border-radius:8px;text-decoration:none}
.skip-link:focus{left:12px}
:focus-visible{outline:2px solid var(--purple);outline-offset:2px}
h1{font-size:22px;font-weight:600;margin:0 0 4px}.sub{font-size:12px;color:var(--mut);margin-bottom:22px}
.bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);padding:10px;position:sticky;top:0;z-index:20;box-shadow:var(--shadow)}
.navscroll{display:flex;gap:6px;align-items:center;flex:1 1 auto;min-width:0;overflow-x:auto;scrollbar-width:thin;padding:2px}
.tab{font-family:inherit;font-size:13px;line-height:1.4;padding:7px 13px;border:1px solid var(--line);background:var(--bg);border-radius:8px;cursor:pointer;color:var(--mut);white-space:nowrap;transition:border-color .15s,color .15s,background .15s,transform .15s}
.tab:hover{border-color:var(--purple);color:var(--purple)}.tab:active{transform:translateY(1px)}.tab.on,.tab[aria-current="page"]{background:var(--purple);color:#fff;border-color:var(--purple)}
.search-wrap{position:relative;flex:0 1 320px;min-width:200px;display:flex;align-items:center}
input.search{font-size:13px;padding:7px 32px 7px 12px;border:1px solid var(--line);border-radius:8px;width:100%;outline:none;background:var(--bg)}
input.search:focus{border-color:var(--purple);box-shadow:0 0 0 3px var(--pp)}
.qclear{position:absolute;right:6px;width:22px;height:22px;border:0;border-radius:6px;background:transparent;color:var(--mut);cursor:pointer;font-size:16px;line-height:1}
.qclear:hover{background:var(--soft);color:var(--ink)}
.context{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--soft);font-size:12px;color:var(--mut)}
.context .vtitle{font-weight:600;color:var(--ink)}.context .hints{color:var(--mut)}
.ctx-chip{display:inline-flex;gap:5px;align-items:center;padding:2px 7px;border-radius:8px;background:var(--bg);border:1px solid var(--line);color:var(--purple)}
.ctx-clear{border:0;background:transparent;color:var(--mut);cursor:pointer;padding:0 2px;font-size:13px;line-height:1}
.ctx-clear:hover{color:var(--red)}.ctx-actions{margin-left:auto;display:flex;gap:6px}
.navgroup{display:flex;gap:6px;align-items:center}
.navgroup.more{display:none}
.bar.expanded .navgroup.more{display:flex}
.navtoggle{font-family:inherit;font-size:12px;padding:7px 10px;border:1px dashed var(--line);border-radius:8px;background:var(--soft);color:var(--mut);cursor:pointer;white-space:nowrap}
.navtoggle:hover{border-color:var(--purple);color:var(--purple)}
.bar.expanded .navtoggle{background:var(--purple);color:#fff;border-style:solid}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:18px}
.stat{font-family:inherit;text-align:left;width:100%;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--soft);cursor:pointer;transition:border-color .15s,transform .15s,box-shadow .15s}
.stat[data-jump]:hover{border-color:var(--purple);transform:translateY(-1px);box-shadow:var(--shadow)}
.stat .n{font-size:26px;font-weight:600;line-height:1.2}.stat .l{font-size:12px;color:var(--mut);margin-top:4px}
.pill{display:inline-block;font-size:11px;padding:2px 9px;border-radius:10px;font-weight:600;white-space:nowrap}
.p-decided{background:var(--gp);color:var(--green)}.p-done{background:var(--bp);color:var(--blue)}
.p-proposed{background:var(--ap);color:var(--amber)}.p-deferred{background:var(--gp2);color:var(--gray)}
.p-superseded{background:var(--rp);color:var(--red)}
.card{border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:12px;background:var(--bg);transition:box-shadow .15s,border-color .15s}
.card:hover{border-color:#cfcfcf;box-shadow:var(--shadow)}
.card.attention{border-left:3px solid var(--amber)}
.card.old{opacity:.72;border-left:3px solid var(--red)}
.chead{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.cid{font-size:12px;font-family:monospace;color:var(--mut)}
.ctitle{font-size:15px;font-weight:600;flex:1;min-width:200px}
.cmeta{font-size:12px;color:var(--mut);margin-top:6px}
.cbody{font-size:13px;margin-top:10px;display:none}
.card.open .cbody{display:block}
.cbody .row{margin:7px 0}.cbody .k{color:var(--mut);font-size:12px;display:inline-block;width:56px;vertical-align:top}
.cbody .v{display:inline-block;width:calc(100% - 62px);vertical-align:top}
.ev{font-size:11px;color:var(--blue);word-break:break-all}
.chain{font-size:12px;background:var(--pp);color:var(--purple);padding:5px 10px;border-radius:6px;display:inline-block;margin:3px 0}
.toggle{font-family:inherit;font-size:12px;color:var(--purple);cursor:pointer;user-select:none;white-space:nowrap;border:0;background:transparent;padding:2px 4px;border-radius:6px}
.toggle:hover{background:var(--pp)}
.backtop{position:fixed;right:20px;bottom:20px;z-index:30;font-family:inherit;font-size:12px;padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--purple);box-shadow:var(--shadow);cursor:pointer}
.backtop:hover{border-color:var(--purple)}
.day{font-size:13px;font-weight:600;color:var(--purple);margin:20px 0 10px;border-bottom:1px dashed var(--line);padding-bottom:6px}
.empty{text-align:center;color:var(--mut);padding:50px 0;font-size:14px}
.mod{border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:12px;background:var(--bg)}
.mod h3{font-size:15px;font-weight:600;margin:0 0 4px}
.mrow{margin:9px 0;font-size:13px}.mrow .k{color:var(--mut);font-size:12px;display:inline-block;width:74px;vertical-align:top}
.mrow .v{display:inline-block;width:calc(100% - 80px);vertical-align:top;word-break:break-all}
.link{color:var(--blue);font-size:12px;display:inline-block;margin:2px 12px 2px 0;text-decoration:none}.link:hover{text-decoration:underline}
.chip{display:inline-block;font-size:11px;padding:2px 8px;border-radius:10px;background:var(--pp);color:var(--purple);margin:2px 5px 2px 0}
.chip.s{background:var(--gp);color:var(--green)}
.foot{margin-top:36px;padding-top:16px;border-top:1px solid var(--line);font-size:12px;color:var(--mut)}
.legend{font-size:11px;color:var(--mut);margin-bottom:18px;display:flex;gap:14px;flex-wrap:wrap}
.proj{border:1px solid var(--line);border-radius:14px;margin-bottom:16px;overflow:hidden;background:var(--bg)}
.proj>summary{cursor:pointer;padding:14px 18px;list-style:none;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.proj>summary::-webkit-details-marker{display:none}
.proj>summary:hover{background:var(--soft)}
.pname{font-size:15px;font-weight:600;flex:1;min-width:160px}
.prole{font-size:12px;color:var(--mut);width:100%;line-height:1.5}
.caret{color:var(--mut);font-size:12px;transition:transform .15s}
.proj[open]>.caret{transform:rotate(90deg)}
.pbody{padding:0 18px 18px;border-top:1px solid var(--line)}
.subhead{font-size:12px;font-weight:600;color:var(--mut);margin:16px 0 8px;letter-spacing:.03em}
.mgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}
.mtile{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--soft)}
.mtile h4{margin:0 0 6px;font-size:13px;font-weight:600}
.comps{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.comp{font-size:11px;font-family:monospace;color:var(--blue);background:var(--bp);padding:2px 7px;border-radius:5px}
.flow{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.fstep{font-size:12px;padding:6px 10px;border-radius:8px;background:var(--gp);color:var(--green);border:1px solid var(--line)}
.fstep b{font-weight:600;margin-right:4px}
.farrow{color:var(--mut);font-size:12px}
.ctrl{border-left:3px solid var(--amber);padding:7px 12px;margin:6px 0;background:var(--ap);border-radius:0 8px 8px 0;font-size:12px}
.ctrl b{font-weight:600;color:var(--amber)}
.ctrl .cd{color:var(--mut);font-size:11px;display:block;margin-top:2px}
.cs{font-size:10px;padding:1px 6px;border-radius:8px;background:var(--rp);color:var(--red);margin-left:6px}
.empty-ctrl{font-size:12px;color:var(--mut)}
.capbar{height:6px;border-radius:4px;background:var(--line);overflow:hidden;margin:5px 0}
.capbar>i{display:block;height:100%;border-radius:4px}
.capcode{font-size:11px;font-family:monospace;color:var(--purple);background:var(--pp);padding:2px 7px;border-radius:5px}
.lvl{display:inline-block;font-size:10px;font-weight:600;padding:2px 6px;border-radius:5px;margin-left:5px}
.l0{background:#F1EFE8;color:#5F5E5A}.l1{background:#E6F1FB;color:#185FA5}.l2{background:#EEEDFE;color:#534AB7}
.l3{background:#FAEEDA;color:#854F0B}.l4{background:#E1F5EE;color:#0F6E56}.l5{background:#0F6E56;color:#fff}
.tier{display:inline-block;font-size:10px;font-weight:600;padding:2px 6px;border-radius:5px;margin-left:5px}
.tier-verified{background:#0F6E56;color:#fff}
.tier-declared{background:var(--soft);color:var(--mut)}
.caprow{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--line)}
.caprow:last-child{border-bottom:none}
.capmeta{flex:1;min-width:0}.capmeta .cn{font-size:13px;font-weight:600}
.capmeta .nx{font-size:11px;color:var(--mut);margin-top:3px}
.capright{width:110px;text-align:right;flex-shrink:0}
.capright .pc{font-size:12px;font-weight:600}
.evlink{font-size:10px;color:var(--blue);margin-top:3px;word-break:break-all;line-height:1.4}
.specbox{background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:12px;line-height:1.7}
.specbox b{color:var(--purple)}
.tree{margin-top:4px}.tkids{margin-left:14px;border-left:1px dashed var(--line);padding-left:10px}
.tnode{font-size:12px;margin:2px 0}.tnode>summary{cursor:pointer;list-style:none;padding:2px 4px;border-radius:6px;color:var(--purple)}
.tnode>summary::-webkit-details-marker{display:none}.tnode>summary:hover{background:var(--soft)}
.tfile{font-size:11px;font-family:monospace;color:var(--mut);padding:1px 4px;word-break:break-all}
.tfile a{color:var(--blue);text-decoration:none}.tfile a:hover{text-decoration:underline}
.idx{background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:8px 10px;margin-top:8px}
.idxtitle{font-size:11px;font-weight:600;color:var(--purple);margin-bottom:5px}
.idxgrp{display:flex;gap:6px;margin:3px 0;font-size:12px;line-height:1.5}
.idxgrp .k{color:var(--mut);font-size:11px;min-width:54px;flex-shrink:0}
.doclink{color:var(--blue);font-size:11px;display:inline-block;margin:1px 8px 1px 0;text-decoration:none}
.doclink:hover{text-decoration:underline}
.caplinks{margin-top:5px}
/* 历史层 / 经验层 */
.evt{border:1px solid var(--line);border-left:3px solid var(--purple);border-radius:10px;padding:12px 14px;margin-bottom:10px;background:var(--bg)}
.evt .eh{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.evt .eseq{font-family:monospace;font-size:13px;color:var(--purple);font-weight:700}
.evt .ets{font-size:11px;color:var(--mut);margin-left:auto}
.fp{font-family:monospace;font-size:10px;color:var(--mut);word-break:break-all;margin-top:6px}
.trchip{font-size:11px;font-family:monospace;padding:3px 8px;border-radius:6px;text-decoration:none}
.tr-up{background:var(--gp);color:var(--green)}.tr-down{background:var(--rp);color:var(--red)}
.snap{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}
.lesson{border:1px solid var(--line);border-radius:10px;padding:13px 15px;margin-bottom:10px;background:var(--bg)}
.lesson.confirmed{border-left:3px solid var(--green)}.lesson.candidate{border-left:3px solid var(--amber)}
.lesson .row{margin:6px 0;font-size:13px}.lesson .k{color:var(--mut);font-size:12px;display:inline-block;width:42px;vertical-align:top}
.lesson .v{display:inline-block;width:calc(100% - 48px);vertical-align:top}
.hrow{font-size:11px;color:var(--mut);padding:3px 0;font-family:monospace}
/* 节点工作台：TODO / issue / 测试结果 / 健康度 */
.wstrip{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--soft);font-size:11px}
.wstrip .wl{color:var(--mut);margin-right:2px}
.wchip{display:inline-block;font-size:11px;padding:2px 8px;border-radius:10px;background:var(--bp);color:var(--blue);white-space:nowrap}
.wchip.w-issue{background:var(--rp);color:var(--red)}
.wchip.w-todo{background:var(--ap);color:var(--amber)}
.wchip.w-test{background:var(--gp);color:var(--green)}
.wchip.w-fail{background:var(--rp);color:var(--red)}
.wchip.w-health{background:var(--gp);color:var(--green)}
.wchip.w-health.mid{background:var(--ap);color:var(--amber)}
.wchip.w-health.bad{background:var(--rp);color:var(--red)}
.wlink{font-size:11px;color:var(--purple);cursor:pointer;text-decoration:none;border:0;background:none;padding:2px 4px}
.wlink:hover{text-decoration:underline}
.wstrip.empty-w{opacity:.72}
.witem{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:10px;background:var(--bg)}
.witem.blocked{border-left:3px solid var(--red)}
.witem.issue{border-left:3px solid var(--amber)}
.witem.done{opacity:.68}
.witem .wmeta{font-size:11px;color:var(--mut);margin-top:5px}
.witem .wdetail{font-size:12px;margin-top:7px;line-height:1.6}
.tcase{font-size:11px;font-family:monospace;padding:5px 8px;border-bottom:1px solid var(--line);word-break:break-all}
.tcase:last-child{border-bottom:none}
.tcase.fail{background:var(--rp);color:var(--red)}
.tcase.pass{color:var(--mut)}
.wgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin-bottom:14px}
.wpanel{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--soft);font-size:12px;line-height:1.7}
.wpanel b{color:var(--purple)}
/* v2.9.0：设计理念 / 架构图 / 数据流 */
.design-hero{border:1px solid var(--line);border-left:3px solid var(--purple);border-radius:12px;padding:16px 18px;margin-bottom:14px;background:var(--soft)}
.design-hero h2{font-size:18px;margin:0 0 6px}.design-hero p{margin:0;color:var(--mut);font-size:13px}
.principle-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.principle{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--bg)}
.principle h3{font-size:14px;margin:0 0 6px;color:var(--purple)}
.principle p{margin:4px 0;font-size:12px;color:var(--ink)}
.principle .k{display:inline-block;font-size:11px;color:var(--mut);margin-right:6px}
.principle .anti{color:var(--red)}
.diagram-wrap{display:grid;gap:14px}
.diagram-card{border:1px solid var(--line);border-radius:12px;background:var(--bg);padding:14px 16px;overflow:hidden}
.diagram-card h2{font-size:15px;margin:0 0 2px}.diagram-card .dsub{font-size:12px;color:var(--mut);margin-bottom:10px}
.diagram-card svg{width:100%;height:auto;display:block}
.dnode{cursor:pointer}.dnode rect{transition:stroke .15s,fill .15s}.dnode:hover rect,.dnode:focus rect{stroke:var(--purple);fill:var(--pp)}
.dnode .dt{font-size:12px;font-weight:600;fill:var(--ink)}.dnode .ds{font-size:10px;fill:var(--mut)}
.dnode .dc{font-size:13px;font-weight:700;fill:var(--purple)}
.dedge{fill:none;stroke:#b9b7d8;stroke-width:1.5;marker-end:url(#arrow)}
.dcount{font-size:10px;fill:var(--mut)}
/* v2.11.0：分析层——热力图 / 趋势 / 健康度 / 卡片墙 / What-if */
.heat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px;margin:12px 0 18px}
.heat-panel{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--bg)}
.heat-panel h3{margin:0 0 4px;font-size:14px}
.heat-scale{display:flex;gap:4px;align-items:center;font-size:10px;color:var(--mut);margin:6px 0 10px}
.heat-scale i{width:22px;height:9px;border-radius:2px;display:inline-block}
.heat-grid .lv0{background:#F1EFE8}.heat-grid .lv1{background:#E6F1FB}.heat-grid .lv2{background:#EEEDFE}
.heat-grid .lv3{background:#FAEEDA}.heat-grid .lv4{background:#E1F5EE}.heat-grid .lv5{background:#0F6E56;color:#fff}
.heat-cells{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:6px}
.heat-cell{font-family:inherit;text-align:left;border:1px solid var(--line);border-radius:8px;padding:7px 9px;cursor:pointer;font-size:11px}
.heat-cell:hover,.heat-cell.sel{outline:2px solid var(--purple);outline-offset:1px}
.heat-cell .hc-code{font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.heat-cell .hc-meta{opacity:.75;font-size:10px}
.trend-wrap{border:1px solid var(--line);border-radius:12px;padding:12px 16px;background:var(--bg);overflow-x:auto}
.trend-wrap svg{min-width:720px;width:100%}
.trend-line{fill:none;stroke-width:2.5}.trend-dot{stroke:#fff;stroke-width:1.5}
.trend-axis{stroke:var(--line);stroke-width:1}.trend-label{font-size:10px;fill:var(--mut)}
.health-dim{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:12px 0 16px}
.hdim{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--soft)}
.hdim .hk{font-size:11px;color:var(--mut);display:flex;justify-content:space-between}
.hdim .hv{font-size:17px;font-weight:600;margin-bottom:5px}
.hbar{height:6px;border-radius:4px;background:var(--line);overflow:hidden}.hbar i{display:block;height:100%;border-radius:4px;background:var(--purple)}
.queue-wall{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin:12px 0 18px}
.qcard{border:1px solid var(--line);border-top:3px solid var(--purple);border-radius:12px;padding:14px 16px;background:var(--bg)}
.qcard .qtop{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px}
.qcard .qrank{font-size:11px;color:var(--mut)}.qcard .qtitle{font-size:13px;font-weight:600;margin:4px 0}
.qcard .qmeta{font-size:11px;color:var(--mut);line-height:1.7}
.qcard .qimpact{font-size:12px;color:var(--green);font-weight:600;margin-top:6px}
.qcard .chip{margin:2px 3px 0 0}
.changed{position:relative}.changed::before{content:'变更';position:absolute;right:6px;top:6px;font-size:10px;color:var(--amber)}
.changed{border-left:3px solid var(--amber)}
.whatif-banner{display:flex;gap:10px;align-items:center;flex-wrap:wrap;border:1px dashed var(--purple);border-radius:10px;padding:9px 12px;background:var(--pp);margin-bottom:12px;font-size:12px}
.whatif-banner .wi-btn{font-family:inherit;font-size:11px;border:1px solid var(--purple);background:var(--bg);color:var(--purple);border-radius:7px;padding:3px 8px;cursor:pointer}
.evidence-chain{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--soft);margin:12px 0 18px}
.evidence-chain h3{margin:0 0 8px;font-size:14px}
/* v2.12.0：本地 D3 视图——沿用同一套浅色变量，不引入第三方外观主题 */
.d3-axis text{font-size:10px;fill:var(--mut)}
.d3-axis path,.d3-axis line{stroke:var(--line)}
.d3-heat-cell{cursor:pointer;stroke:var(--line);stroke-width:1}
.d3-heat-cell:hover,.d3-heat-cell:focus{stroke:var(--purple);stroke-width:2;outline:none}
.d3-heat-title{font-size:12px;font-weight:600;fill:var(--ink)}
.d3-heat-axis{font-size:10px;fill:var(--mut)}
.d3-heat-label{font-size:10px;font-weight:600;fill:var(--ink);pointer-events:none}
.d3-heat-sub{font-size:10px;fill:var(--mut);pointer-events:none}
.lineage-tree{border:1px solid var(--line);border-radius:12px;padding:12px 16px;background:var(--bg);overflow-x:auto;margin:10px 0 16px}
.lineage-tree svg{min-width:720px;width:100%}
.lineage-node{cursor:pointer}.lineage-node circle{stroke:#fff;stroke-width:2}
.lineage-node text{font-size:11px;fill:var(--ink)}
.lineage-link{fill:none;stroke:var(--line);stroke-width:1.5}
.lineage-detail{border:1px dashed var(--purple);border-radius:9px;padding:8px 11px;background:var(--pp);font-size:11px;line-height:1.7;margin:10px 0}
.lineage-detail code{word-break:break-all}
.lineage-tree details summary{cursor:pointer;font-size:12px;padding:3px 0}
.lineage-children{margin-left:18px;border-left:1px solid var(--line);padding-left:10px}
/* v2.10.0：工作台视角——先给结论和入口，再给明细 */
.focus-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-bottom:14px}
.focus-card{border:1px solid var(--line);border-top:3px solid var(--amber);border-radius:12px;padding:14px 16px;background:var(--bg)}
.focus-card.good{border-top-color:var(--green)}.focus-card.bad{border-top-color:var(--red)}
.focus-card .fk{font-size:12px;color:var(--mut)}.focus-card .fv{font-size:22px;font-weight:600;margin:3px 0}
.focus-card .fa{font-family:inherit;font-size:12px;color:var(--purple);border:0;background:none;padding:2px 0;cursor:pointer}
.focus-card .fa:hover{text-decoration:underline}
.trustbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;border:1px solid var(--line);border-radius:12px;padding:10px 14px;background:var(--soft);margin-bottom:16px;font-size:12px}
.trustbar .tb{display:inline-flex;gap:5px;align-items:center;padding:3px 9px;border-radius:8px;background:var(--bg);border:1px solid var(--line)}
.trustbar .tb b{color:var(--ink)}.trustbar .src{margin-left:auto;color:var(--mut)}
.launchpad{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:14px 0 18px}
.launch{font-family:inherit;text-align:left;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--bg);cursor:pointer;transition:border-color .15s,transform .15s,box-shadow .15s}
.launch:hover{border-color:var(--purple);transform:translateY(-1px);box-shadow:var(--shadow)}
.launch .lt{font-size:14px;font-weight:600;color:var(--purple)}.launch .ld{font-size:12px;color:var(--mut);margin:4px 0}.launch .ln{font-size:21px;font-weight:600}
.diagram-scroll{overflow-x:auto;padding-bottom:6px}.diagram-scroll svg{min-width:720px}
.dnode.hit rect{stroke-width:3;stroke:var(--amber)}
/* 体验层：小屏与降低动态效果 */
@media (max-width: 760px){
  body{padding:18px 14px 80px}
  h1{font-size:20px}
  .bar{position:sticky;top:0;padding:8px;border-radius:10px}
  .navscroll{order:1;flex-basis:100%;padding-bottom:4px}
  .search-wrap{order:2;flex-basis:100%;min-width:0}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .stat{padding:11px 12px}.stat .n{font-size:22px}
  .card,.mod,.witem{padding:13px 14px}
  .ctitle{min-width:140px}.cbody .k{width:48px}.cbody .v{width:calc(100% - 54px)}
  .mrow .k{width:64px}.mrow .v{width:calc(100% - 70px)}
  .capright{width:88px}.capmeta .cn{line-height:1.5}
  .wgrid{grid-template-columns:1fr}
  .context .ctx-actions{margin-left:0}
  .principle-grid{grid-template-columns:1fr}
  .diagram-card{padding:10px}
  .focus-grid,.launchpad{grid-template-columns:1fr}
  .heat-grid,.queue-wall,.health-dim{grid-template-columns:1fr}
  .trustbar .src{margin-left:0}
}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition:none!important;animation:none!important}
}
@media print{
  .bar,.skip-link,.backtop,.ctx-actions{display:none!important}
  body{max-width:none;padding:0}
  .card,.mod,.witem{break-inside:avoid}
}
