  bindWorkLinks(box);bindMore(box);markChanges(box);
}

function setView(v){
  if(!v||!VIEW_META[v]) return;
  view=v; pageLimit=PAGE_SIZE; workScope='';
  const tabs=document.querySelectorAll('.bar .tab');
  tabs.forEach(t=>{
    const on=t.dataset.v===v;
    if(t.classList){
      if(t.classList.toggle) t.classList.toggle('on',on);
      else {t.classList.remove('on'); if(on)t.classList.add('on');}
    }
    if(t.setAttribute) on?t.setAttribute('aria-current','page'):t.removeAttribute('aria-current');
    else if(t.removeAttribute && !on) t.removeAttribute('aria-current');
  });
  const more=document.getElementById('navmore');
  if(more && more.querySelector && more.querySelector('.tab[data-v="'+v+'"]')) toggleNav(true);
  if(typeof window!=='undefined' && window.scrollTo) window.scrollTo({top:0,behavior:'smooth'});
  render();
}
function clearQuery(){
  query='';pageLimit=PAGE_SIZE;
  const q=document.getElementById('q'); if(q) q.value='';
  const c=document.getElementById('qclear'); if(c) c.hidden=true;
