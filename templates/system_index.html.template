<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CapabilityForge · 系统级账本看板</title>
<style>
:root{--ink:#1a1a1a;--mut:#666;--line:#e3e3e3;--bg:#fff;--soft:#f7f7f5;--purple:#534AB7;--pp:#EEEDFE;--green:#0F6E56;--gp:#E1F5EE;--amber:#854F0B;--ap:#FAEEDA;--red:#A32D2D;--rp:#FCEBEB;--blue:#185FA5;--bp:#E6F1FB;--gray:#5F5E5A;--gp2:#F1EFE8}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--ink);line-height:1.6;max-width:1180px;margin:0 auto;padding:32px 26px 72px;background:var(--bg)}
.skip{position:absolute;left:-9999px;top:8px;background:var(--ink);color:#fff;padding:8px 14px;border-radius:8px;text-decoration:none;z-index:10}.skip:focus{left:12px}
h1{font-size:22px;font-weight:600;margin:0 0 4px}h2{font-size:16px;font-weight:600;margin:22px 0 10px}h3{font-size:14px;font-weight:600;margin:0 0 6px}
.sub{font-size:12px;color:var(--mut);margin-bottom:18px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:16px 0 20px}
.stat{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--soft);cursor:pointer}
.stat:hover{border-color:var(--purple)}.stat .n{font-size:22px;font-weight:600}.stat .l{font-size:12px;color:var(--mut)}
.bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
input,select{border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:13px;background:#fff;color:var(--ink)}
input#q{flex:1;min-width:220px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0 12px;border-bottom:1px solid var(--line);padding-bottom:8px}
.tab{border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 12px;font-size:13px;cursor:pointer;color:var(--mut)}
.tab.on{background:var(--pp);border-color:var(--purple);color:var(--purple)}
.card{border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:10px;background:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:12px}
.meta{font-size:12px;color:var(--mut)}.chip{display:inline-block;border-radius:999px;padding:1px 8px;font-size:11px;margin-right:6px;background:var(--gp2);color:var(--gray)}
.chip.v{background:var(--gp);color:var(--green)}.chip.d{background:var(--ap);color:var(--amber)}.chip.lv{background:var(--bp);color:var(--blue)}
.chip.r{background:var(--rp);color:var(--red)}.chip.p{background:var(--pp);color:var(--purple)}
a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}
details{border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:8px 0;background:#fff}
summary{cursor:pointer;font-size:13px;font-weight:500}summary:hover{color:var(--purple)}
.tree{margin:10px 0 4px 12px;border-left:1px solid var(--line);padding-left:12px}
.cap{border-bottom:1px dashed var(--line);padding:7px 0;font-size:13px}.cap:last-child{border-bottom:0}
.cap .code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--mut)}
.bar-mini{height:5px;background:var(--gp2);border-radius:4px;overflow:hidden;margin-top:4px;max-width:180px}.bar-mini i{display:block;height:100%;background:var(--green)}
table{border-collapse:collapse;width:100%;font-size:13px}th,td{border-bottom:1px solid var(--line);padding:8px 10px;text-align:left}th{font-weight:500;color:var(--mut);background:var(--soft)}
.empty{color:var(--mut);font-size:13px;padding:18px 0}
.hint{font-size:12px;color:var(--mut);margin-top:6px}
mark{background:var(--ap);color:inherit}
footer{margin-top:34px;border-top:1px solid var(--line);padding-top:14px;font-size:12px;color:var(--mut)}
.layer{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0 16px;font-size:12px}
.layer span{border:1px solid var(--line);border-radius:8px;padding:5px 10px;background:var(--soft)}
.layer b{font-weight:500;color:var(--purple)}
.spark{width:100%;max-width:300px;height:52px;border:1px solid var(--line);border-radius:8px;background:var(--soft)}
.big{font-size:20px;font-weight:600}
.linklike{border:0;background:none;padding:0;color:var(--blue);cursor:pointer;font-size:inherit;text-decoration:underline;font-family:inherit}
.backdrop{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:20}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(760px,94vw);background:#fff;z-index:21;overflow:auto;padding:24px 26px 56px;box-shadow:-10px 0 30px rgba(0,0,0,.15)}
.drawer h2{margin:0 0 4px}.drawer h3{margin:18px 0 8px}.close{float:right;border:1px solid var(--line);background:#fff;border-radius:8px;padding:4px 10px;cursor:pointer;color:var(--mut)}
.section{border-top:1px solid var(--line);margin-top:16px;padding-top:6px}
</style>
</head>
<body>
<a class="skip" href="#main">跳到主内容</a>
<h1>CapabilityForge · 系统级账本看板</h1>
<p class="sub" id="asof">从各项目账本实时投影 · 系统 → 项目 → 模块 → 能力点</p>
<p class="sub" id="persona-hint"></p>
<div class="stats" id="stats"></div>
<nav class="tabs" id="tabs">
  <button class="tab on" type="button" data-v="overview">系统总览</button>
  <button class="tab" type="button" data-v="projects">项目与模块</button>
  <button class="tab" type="button" data-v="matrix">能力矩阵</button>
  <button class="tab" type="button" data-v="compat">组合兼容</button>
  <button class="tab" type="button" data-v="timeline">时间趋势</button>
  <button class="tab" type="button" data-v="sources">数据来源</button>
</nav>
<div class="bar">
  <input id="q" type="search" placeholder="搜索项目 / 模块 / 能力编码 / 名称…" aria-label="搜索系统看板">
  <select id="persona" aria-label="操作人视角"><option value="novice">门外汉</option><option value="standard" selected>标准</option><option value="expert">专家</option></select>
  <select id="tier" aria-label="证据层级筛选"><option value="">全部证据层</option><option value="verified">verified</option><option value="declared">declared</option></select>
  <select id="level" aria-label="等级筛选"><option value="">全部等级</option><option value="0">L0</option><option value="1">L1</option><option value="2">L2</option><option value="3">L3</option><option value="4">L4</option><option value="5">L5</option></select>
</div>
<div class="layer" id="layer"><b>系统</b><span>CapabilityForge</span><span>→ 项目（各开发仓）</span><span>→ 模块</span><span>→ 能力点（证据分层）</span></div>
<main id="main">
  <section id="view-overview"></section>
  <section id="view-projects" hidden></section>
  <section id="view-matrix" hidden></section>
  <section id="view-compat" hidden></section>
  <section id="view-timeline" hidden></section>
  <section id="view-sources" hidden></section>
</main>
<div class="backdrop" id="backdrop" hidden></div>
<aside class="drawer" id="drawer" aria-label="项目级账本" hidden><div id="drawer-body"></div></aside>
<footer id="foot"></footer>
<script>
const SYSTEM_DATA = /*SYSTEM*/;
let DATA = SYSTEM_DATA;
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function hl(s,q){s=esc(s);if(!q)return s;const i=s.toLowerCase().indexOf(q.toLowerCase());return i<0?s:s.slice(0,i)+'<mark>'+s.slice(i,i+q.length)+'</mark>'+s.slice(i+q.length);}
function hits(s,q){return !q||String(s||'').toLowerCase().indexOf(q.toLowerCase())>=0;}
function allCaps(){const out=[];(DATA.projects||[]).forEach(p=>(p.modules||[]).forEach(m=>(m.caps||[]).forEach(c=>out.push(Object.assign({_project:p,_module:m},c)))));return out;}
function filtered(){const q=document.getElementById('q').value.trim(),t=document.getElementById('tier').value,l=document.getElementById('level').value;
  return allCaps().filter(c=>hits([c.code,c.name,c._project.code,c._project.title,c._module.code,c._module.name].join(' '),q)&&(!t||(c.evidence_tier||'declared')===t)&&(l===''||Number(c.level)===Number(l)));}
function pct(x){return ((Number(x)||0)*100).toFixed(0)+'%';}
function evidenceText(e){if(!e)return '—';if(Array.isArray(e))return e.join(', ');if(typeof e==='string')return e;
  return Object.keys(e).filter(k=>Array.isArray(e[k])&&e[k].length).map(k=>k+': '+e[k].join(', ')).join(' · ')||'—';}
function statCard(n,l,view){return '<div class="stat" data-go="'+view+'"><div class="n">'+esc(n)+'</div><div class="l">'+esc(l)+'</div></div>';}
let view='overview',mode='standard';
const VIEWS=['overview','projects','matrix','compat','timeline','sources'];
const COMPAT_CN={ok:'满足',below_anchor:'版本过低',repo_missing:'兄弟仓缺失',bad_config:'配置不完整',version_unreadable:'版本读不到',version_not_found:'找不到版本',version_unparsable:'版本无法比较'};
const STALE_CN={fresh:'近期有更新',aging:'需要关注',stale:'长期未动',no_events:'无历史记录',unknown:'无法判断'};
const PERSONA_HINT={novice:'门外汉视角：只看能不能信、有没有停滞、组合是否兼容，以及下一步做什么。',standard:'标准视角：完整工作台，可筛选证据层与等级并展开项目树。',expert:'专家视角：额外显示绑定状态、证据路径、骨架摘要与事件明细。'};
function compatChip(s){return '<span class="chip '+(s==='ok'?'v':'r')+'">'+esc(COMPAT_CN[s]||s||'—')+'</span>';}
function staleChip(h){const s=(h||{}).stale_status||'unknown';return '<span class="chip '+(s==='fresh'?'v':(s==='stale'?'r':'d'))+'">'+esc(STALE_CN[s]||s)+'</span>';}
function renderStats(){const caps=allCaps(),v=caps.filter(c=>c.evidence_tier==='verified').length,c=DATA.compat||{},cs=c.summary||{};
  document.getElementById('stats').innerHTML=statCard(DATA.projects.length,'在册项目','projects')+
    statCard(caps.length,'能力点','matrix')+
    statCard(caps.length?Math.round(v/caps.length*100)+'%':'—','verified 覆盖','matrix')+
    statCard((cs.total||0)+' / '+(cs.blocked||0),'组合锚 / 阻断','compat');
  document.getElementById('asof').textContent='数据截至 '+(DATA.meta.as_of||'—')+' · 由脚本从各项目账本投影 · '+DATA.projects.length+' 个项目';}
function renderNovice(){const caps=allCaps(),v=caps.filter(c=>c.evidence_tier==='verified').length,c=DATA.compat||{},cs=c.summary||{};
  const stale=DATA.projects.map(p=>({name:p.title,h:p.history||{}})).sort((a,b)=>(Number(b.h.stale_hours)||0)-(Number(a.h.stale_hours)||0));
  const next=[...new Set(caps.map(x=>x.next_action).filter(Boolean))].slice(0,3);
  const staleHtml=stale.map(x=>'<div class="meta">'+esc(x.name)+'：'+esc(STALE_CN[x.h.stale_status]||'—')+(x.h.stale_hours==null?'':'（距今 '+esc(x.h.stale_hours)+' 小时）')+'</div>').join('');
  const compatHtml=(c.anchors||[]).map(a=>'<div class="meta">'+esc(a.consumer)+' → '+esc(a.provider)+'：'+esc(COMPAT_CN[a.status]||a.status)+'</div>').join('')||'<div class="meta">没有声明组合锚</div>';
  const nextHtml=next.map(x=>'<li class="meta">'+esc(x)+'</li>').join('')||'<li class="meta">暂无待办</li>';
  document.getElementById('view-overview').innerHTML='<h2>今天看什么</h2><div class="grid">'+
    '<article class="card"><h3>能不能信</h3><div class="big">'+esc(caps.length?Math.round(v/caps.length*100)+'%':'—')+'</div><div class="meta">'+esc(v)+' / '+esc(caps.length)+' 个能力点有可执行证据，其余只是声明。</div></article>'+
    '<article class="card"><h3>有没有停滞</h3>'+(staleHtml||'<div class="meta">暂无项目</div>')+'<div class="hint">时间相对系统内最新账本更新时刻，可复算。</div></article>'+
    '<article class="card"><h3>组合是否兼容</h3>'+compatHtml+'<div class="hint">阻断项：'+esc(cs.blocked||0)+' 个；升级前请先看「组合兼容」。</div></article>'+
    '<article class="card"><h3>下一步做什么</h3><ul>'+nextHtml+'</ul><div class="hint">来自能力点账本，不是临时建议。</div></article></div>';}
function renderOverview(){if(mode==='novice')return renderNovice();
  const q=document.getElementById('q').value.trim(),cards=DATA.projects.filter(p=>hits([p.code,p.title,p.role,p.dir].join(' '),q)).map(p=>{
    const caps=(p.modules||[]).reduce((a,m)=>a.concat(m.caps||[]),[]),v=caps.filter(c=>c.evidence_tier==='verified').length,h=p.history||{};
    return '<article class="card"><h3>'+hl(p.title,q)+' <span class="chip">'+esc(p.code)+'</span>'+staleChip(h)+'</h3>'+
      '<div class="meta">'+hl(p.role||'',q)+' · 开发仓 '+esc(p.dir)+'</div>'+
      '<div class="meta" style="margin:8px 0">'+(p.modules||[]).length+' 模块 · '+caps.length+' 能力点 · verified '+v+'/'+caps.length+' · 完成度 '+pct(p.completion)+'</div>'+
      (mode==='expert'?'<div class="meta">最近事件 '+esc(h.last_event_ts||'—')+' · 事件 '+esc(h.events||0)+' 次 · 距观察点 '+esc(h.stale_hours==null?'—':h.stale_hours)+' 小时</div>':'')+
      '<div class="bar-mini"><i style="width:'+Math.min(100,Math.round((caps.length?v/caps.length*100:0)))+'%"></i></div>'+
      '<div class="hint"><button class="linklike" type="button" data-drill="'+esc(p.dir)+'">查看项目账本 →</button> · <a href="'+esc(p.board)+'">项目看板 ↗</a> · 账本 '+esc(p.ledger)+'</div></article>';}).join('');
  document.getElementById('view-overview').innerHTML='<h2>在册项目</h2><div class="grid">'+(cards||'<div class="empty">无匹配项目</div>')+'</div>';}
function capHtml(c,q){let s='<div class="cap"><span class="code">'+hl(c.code,q)+'</span> '+hl(c.name,q)+
  ' <span class="chip lv">'+esc(c.level_code||('L'+c.level))+'</span><span class="chip '+(c.evidence_tier==='verified'?'v':'d')+'">'+esc(c.evidence_tier||'declared')+'</span>'+
  '<div class="meta">完成度 '+pct(c.completion)+' · 下步 '+esc(c.next_action||'—')+'</div>';
  if(mode==='expert')s+='<div class="meta">绑定 '+esc(c.binding_status||'—')+' · 证据 '+esc(evidenceText(c.evidence))+'</div>';
  return s+'</div>';}
function renderProjects(){const q=document.getElementById('q').value.trim(),caps=filtered();
  const body=DATA.projects.map(p=>{const mods=(p.modules||[]).map(m=>{const mc=caps.filter(c=>c._project.code===p.code&&c._module.code===m.code);
      if(q&&!mc.length&&!hits(m.code+' '+m.name,q))return '';
      return '<details><summary>'+hl(m.name,q)+' <span class="chip">'+esc(m.code)+'</span><span class="chip">'+mc.length+' 能力点</span></summary><div class="tree">'+
        (mc.map(c=>capHtml(c,q)).join('')||'<div class="empty">无匹配能力点</div>')+'</div></details>';}).join('');
    if(q&&!mods)return '';
    return '<details open><summary>'+hl(p.title,q)+' <span class="chip">'+esc(p.code)+'</span><span class="chip s">'+pct(p.completion)+'</span></summary>'+
      '<div class="meta" style="margin:8px 0">'+esc(p.dir)+' · <button class="linklike" type="button" data-drill="'+esc(p.dir)+'">项目账本 →</button> · <a href="'+esc(p.board)+'">项目看板 ↗</a></div>'+mods+'</details>';}).join('');
  document.getElementById('view-projects').innerHTML='<h2>系统 → 项目 → 模块 → 能力点</h2>'+(body||'<div class="empty">无匹配节点</div>');}
function renderMatrix(){const q=document.getElementById('q').value.trim(),caps=filtered();
  const groups=[];DATA.projects.forEach(p=>(p.modules||[]).forEach(m=>groups.push({p:p,m:m,caps:caps.filter(c=>c._project.code===p.code&&c._module.code===m.code)})));
  const rows=groups.filter(g=>!q||g.caps.length||hits(g.p.title+' '+g.m.name+' '+g.m.code,q)).map(g=>{
    const dist=[0,0,0,0,0,0];g.caps.forEach(c=>dist[Number(c.level)||0]++);
    const v=g.caps.filter(c=>c.evidence_tier==='verified').length;
    return '<tr><td>'+hl(g.p.title,q)+'</td><td>'+hl(g.m.name,q)+'</td><td>'+esc(g.m.code)+'</td><td>'+g.caps.length+'</td>'+
      dist.map(n=>'<td>'+(n||'·')+'</td>').join('')+'<td>'+v+'</td></tr>';}).join('');
  document.getElementById('view-matrix').innerHTML='<h2>模块 × L0–L5 能力矩阵</h2><div class="meta">按当前搜索与筛选实时统计；数据来自账本，不是手绘图。</div>'+
    '<table><thead><tr><th>项目</th><th>模块</th><th>编码</th><th>能力</th><th>L0</th><th>L1</th><th>L2</th><th>L3</th><th>L4</th><th>L5</th><th>verified</th></tr></thead><tbody>'+(rows||'<tr><td colspan="11" class="empty">无匹配</td></tr>')+'</tbody></table>';}
function renderCompat(){const q=document.getElementById('q').value.trim(),c=DATA.compat||{},cs=c.summary||{};
  const rows=(c.anchors||[]).filter(a=>hits([a.consumer,a.provider,a.repo,a.note,a.status].join(' '),q)).map(a=>
    '<tr><td>'+hl(a.consumer,q)+'</td><td>'+hl(a.provider,q)+'</td><td>'+esc(a.min_version||'—')+'</td><td>'+esc(a.found_version||'—')+'</td><td>'+compatChip(a.status)+'</td><td>'+hl(a.note||'',q)+'</td></tr>').join('');
  const impacts=(c.impact||[]).map(x=>'<tr><td>'+esc(x.provider)+'</td><td>'+(x.consumers||[]).map(y=>'<span class="chip p">'+esc(y)+'</span>').join('')+'</td><td>'+esc((x.consumers||[]).length)+'</td></tr>').join('');
  document.getElementById('view-compat').innerHTML='<h2>组合兼容与升级影响面</h2>'+
    '<div class="meta">锚来自各仓 spec_check.json，目标版本由脚本读取并机械比较；共 '+esc(cs.total||0)+' 锚，阻断 '+esc(cs.blocked||0)+' 个。升级提供方前先看影响面。</div>'+
    '<table><thead><tr><th>消费方</th><th>提供方</th><th>最低版本</th><th>实测版本</th><th>状态</th><th>说明</th></tr></thead><tbody>'+(rows||'<tr><td colspan="6" class="empty">无匹配组合锚</td></tr>')+'</tbody></table>'+
    '<h3>升级影响面</h3><table><thead><tr><th>提供方</th><th>消费方</th><th>数量</th></tr></thead><tbody>'+(impacts||'<tr><td colspan="3" class="empty">无依赖声明</td></tr>')+'</tbody></table>';}
function spark(series){if(!series||!series.length)return '<div class="empty">无历史快照</div>';
  const pts=series.map((s,i)=>{const x=series.length===1?120:10+i*220/(series.length-1),y=44-(Number(s.verified_coverage)||0)*36;return x.toFixed(1)+','+y.toFixed(1);}).join(' ');
  const last=series[series.length-1],lx=series.length===1?120:230,ly=44-(Number(last.verified_coverage)||0)*36;
  return '<svg class="spark" viewBox="0 0 240 52" role="img" aria-label="verified 覆盖率趋势"><line x1="10" y1="44" x2="230" y2="44" stroke="#e3e3e3"/><polyline fill="none" stroke="#534AB7" stroke-width="2" points="'+pts+'"/><circle cx="'+lx+'" cy="'+ly.toFixed(1)+'" r="3" fill="#0F6E56"/></svg>';}
function timelineHtml(p,q){const h=p.history||{},ss=h.series||[];
  const rows=ss.slice(-8).reverse().map(s=>'<tr><td>'+esc(s.seq)+'</td><td>'+esc(s.ts)+'</td><td>'+esc(s.type)+'</td><td>'+esc(s.caps)+'</td><td>'+esc(s.verified)+'</td><td>'+pct(s.verified_coverage)+'</td><td>'+esc(s.avg_level)+'</td><td>'+esc(s.level_transitions)+'</td><td>'+esc(s.evidence_changes)+'</td></tr>').join('');
  return '<article class="card"><h3>'+hl(p.title,q)+' '+staleChip(h)+'</h3><div class="meta">事件 '+esc(h.events||0)+' 次 · 最近 '+esc(h.last_event_ts||'—')+' · 距观察点 '+esc(h.stale_hours==null?'—':h.stale_hours)+' 小时</div>'+
    spark(ss)+'<table style="margin-top:10px"><thead><tr><th>序</th><th>时间</th><th>类型</th><th>能力</th><th>verified</th><th>覆盖</th><th>均等级</th><th>升级</th><th>证据变化</th></tr></thead><tbody>'+(rows||'<tr><td colspan="9" class="empty">无事件</td></tr>')+'</tbody></table></article>';}
function renderTimeline(){const q=document.getElementById('q').value.trim();
  const body=DATA.projects.filter(p=>hits([p.title,p.code,p.dir].join(' '),q)).map(p=>timelineHtml(p,q)).join('');
  document.getElementById('view-timeline').innerHTML='<h2>时间趋势与停滞</h2><div class="meta">从账本 history.events 的 state_digest 复算；观察点是系统内最新账本更新时间（'+esc((DATA.meta||{}).as_of||'—')+'），不用机器当前时间，保证重生成幂等。超过 24 小时标「需要关注」，超过 72 小时标「长期未动」。</div>'+(body||'<div class="empty">无匹配项目</div>');}
function renderSources(){const d=DATA.meta||{},rows=DATA.projects.map(p=>'<tr><td>'+esc(p.code)+'</td><td>'+esc(p.title)+'</td><td>'+esc(p.ledger)+'</td><td>'+esc(p.board)+'</td><td>'+esc(p.version||'—')+'</td>'+(mode==='expert'?'<td>'+esc((p.history||{}).events||0)+'</td>':'')+'</tr>').join('');
  document.getElementById('view-sources').innerHTML='<h2>数据来源</h2><div class="meta">系统看板只做投影；各项目账本仍是唯一事实源。骨架摘要 '+esc(d.skeleton_digest||'—')+'</div>'+
    '<table><thead><tr><th>项目码</th><th>名称</th><th>账本</th><th>看板</th><th>版本</th>'+(mode==='expert'?'<th>事件数</th>':'')+'</tr></thead><tbody>'+rows+'</tbody></table>'+
    '<div class="hint">重生成：<code>python3 ledger-driven-dev/scripts/build_system_board.py --system-root .. --apply</code> · 校验：<code>... check</code></div>';}
function projectByDir(dir){return (DATA.projects||[]).find(p=>p.dir===dir);}
function renderDrill(p){const d=p.detail||{},h=d.health||{},dims=h.health_dimensions||{};
  const caps=(p.modules||[]).reduce((a,m)=>a.concat(m.caps||[]),[]),v=caps.filter(c=>c.evidence_tier==='verified').length;
  const decisions=(d.decisions||[]).map(e=>'<tr><td>'+esc(e.id)+'</td><td>'+esc(e.date||'—')+'</td><td>'+esc(e.title||'—')+'</td><td>'+esc(e.status||'—')+'</td><td>'+esc(e.decision||'—')+'</td></tr>').join('');
  const works=(d.work_items||[]).map(w=>'<tr><td>'+esc(w.id)+'</td><td>'+esc(w.status||'—')+'</td><td>'+esc(w.severity||'—')+'</td><td>'+esc(w.title||'—')+'</td><td>'+esc(w.scope||'—')+'</td><td>'+esc(w.owner||'—')+'</td></tr>').join('');
  const mods=(p.modules||[]).map(m=>'<details open><summary>'+esc(m.name)+' <span class="chip">'+esc(m.code)+'</span><span class="chip">'+(m.caps||[]).length+' 能力点</span></summary><div class="tree">'+(m.caps||[]).map(c=>capHtml(c,'')).join('')+'</div></details>').join('');
  const dimHtml=Object.keys(dims).map(k=>'<tr><td>'+esc(k)+'</td><td>'+esc(dims[k])+'</td></tr>').join('');
  return '<button class="close" type="button" data-close>关闭 ×</button><h2>'+esc(p.title)+'</h2>'+
    '<div class="meta">'+esc(p.code)+' · '+esc(p.dir)+' · 版本 '+esc(p.version||'—')+' · 账本更新 '+esc(p.last_updated||'—')+' '+staleChip(p.history||{})+'</div>'+
    '<div class="meta" style="margin:8px 0">'+esc(d.purpose||'')+'</div>'+
    '<div class="stats"><div class="stat"><div class="n">'+(p.modules||[]).length+'</div><div class="l">模块</div></div><div class="stat"><div class="n">'+caps.length+'</div><div class="l">能力点</div></div><div class="stat"><div class="n">'+v+'</div><div class="l">verified</div></div><div class="stat"><div class="n">'+esc(h.health_overall==null?'—':h.health_overall)+'</div><div class="l">健康总分</div></div></div>'+
    '<div class="section"><h3>决策记录 '+esc((d.decisions||[]).length)+'</h3><table><thead><tr><th>ID</th><th>日期</th><th>标题</th><th>状态</th><th>裁决</th></tr></thead><tbody>'+(decisions||'<tr><td colspan="5" class="empty">无决策</td></tr>')+'</tbody></table></div>'+
    '<div class="section"><h3>工作项 '+esc((d.work_items||[]).length)+'</h3><table><thead><tr><th>ID</th><th>状态</th><th>级别</th><th>标题</th><th>范围</th><th>负责人</th></tr></thead><tbody>'+(works||'<tr><td colspan="6" class="empty">无工作项</td></tr>')+'</tbody></table></div>'+
    '<div class="section"><h3>能力点（项目级账本投影）</h3>'+(mods||'<div class="empty">无能力点</div>')+'</div>'+
    '<div class="section"><h3>健康维度</h3><table><thead><tr><th>维度</th><th>分值</th></tr></thead><tbody>'+(dimHtml||'<tr><td colspan="2" class="empty">无健康数据</td></tr>')+'</tbody></table></div>'+
    '<div class="section">'+timelineHtml(p,'')+'</div>'+
    '<div class="section"><h3>数据来源</h3><div class="meta">账本 '+esc(p.ledger)+' · 项目看板 <a href="'+esc(p.board)+'">'+esc(p.board)+' ↗</a></div><div class="hint">抽屉内容由系统看板从项目账本投影；预览面板隔离单文件，外链请在本地文件系统打开时点击。</div></div>';}
function openDrill(dir){const p=projectByDir(dir);if(!p)return;
  document.getElementById('drawer-body').innerHTML=renderDrill(p);
  document.getElementById('drawer').hidden=false;document.getElementById('backdrop').hidden=false;}
function closeDrill(){document.getElementById('drawer').hidden=true;document.getElementById('backdrop').hidden=true;}
function render(){renderStats();VIEWS.forEach(v=>{document.getElementById('view-'+v).hidden=v!==view;});
  if(view==='overview')renderOverview();else if(view==='projects')renderProjects();else if(view==='matrix')renderMatrix();
  else if(view==='compat')renderCompat();else if(view==='timeline')renderTimeline();else renderSources();}
function setMode(m){mode=m;document.body.className='mode-'+m;
  document.getElementById('persona-hint').textContent=PERSONA_HINT[m]||'';
  const allowed=m==='novice'?['overview']:VIEWS;
  document.querySelectorAll('.tab').forEach(t=>{t.hidden=allowed.indexOf(t.dataset.v)<0;});
  ['tier','level'].forEach(id=>{document.getElementById(id).hidden=m==='novice';});
  if(m==='novice')view='overview';
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.v===view));
  render();}
function init(){document.getElementById('tabs').addEventListener('click',e=>{const b=e.target.closest('.tab');if(!b)return;view=b.dataset.v;
    document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t===b));render();});
  ['q','tier','level'].forEach(id=>document.getElementById(id).addEventListener('input',render));
  document.getElementById('persona').addEventListener('change',e=>setMode(e.target.value));
  document.getElementById('stats').addEventListener('click',e=>{const s=e.target.closest('[data-go]');if(!s)return;view=s.dataset.go;
    if(mode==='novice'&&view!=='overview')return;
    document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.v===view));render();});
  document.getElementById('main').addEventListener('click',e=>{const b=e.target.closest('[data-drill]');if(b)openDrill(b.dataset.drill);});
  document.getElementById('drawer').addEventListener('click',e=>{if(e.target.closest('[data-close]'))closeDrill();});
  document.getElementById('backdrop').addEventListener('click',closeDrill);
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDrill();});
  document.getElementById('foot').textContent='系统看板为生成物 · 权威模板 templates/system_index.html.template · 生成器 scripts/build_system_board.py · 禁止手改 HTML';
  setMode('standard');}
init();
</script>
</body>
</html>
